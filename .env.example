# Copy to .env and fill in your values

# Obtain your API key from: https://www.immport.org/auth/api/keys
# Download the JSON and copy the value of the "api_key" field.
# Keys are valid for 30 days — generate a new one when it expires.
IMMPORT_API_KEY=your_30_day_jwt_api_key_here

# Optional overrides
IMMPORT_BASE_URL=https://immport.org/data/query
MCP_TRANSPORT=stdio
RESPONSE_CACHE_TTL=300
RESPONSE_CACHE_MAXSIZE=512

# Usage metrics: each tool call sends one record (tool name, parameters, your ImmPort
# username) to ImmPort's metric service. Set to false to send nothing.
IMMPORT_METRICS_ENABLED=true
